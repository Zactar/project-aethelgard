{
  "name": "Project Aethelgard - Multi-Agent Runtime",
  "image": "mcr.microsoft.com/devcontainers/python:3.11-bookworm",
  "features": {
    "ghcr.io/devcontainers/features/docker-outside-of-docker:1": {
      "moby": false,
      "installDockerBuildx": true
    }
  },
  "forwardPorts": [8765, 8766, 8000],
  "portsAttributes": {
    "8765": {
      "label": "Cognitive IPC & State Bridge (WS)",
      "onAutoForward": "notify"
    },
    "8766": {
      "label": "Streaming 24kHz PCM Audio (WS)",
      "onAutoForward": "silent"
    },
    "8000": {
      "label": "Chroma Vector Database",
      "onAutoForward": "silent"
    }
  },
  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "editor.formatOnSave": true
      },
      "extensions": [
        "ms-python.python",
        "charliermarsh.ruff"
      ]
    }
  },
  "postCreateCommand": "pip install --upgrade pip setuptools wheel && pip install -r requirements.txt",
  "remoteUser": "vscode"
}
