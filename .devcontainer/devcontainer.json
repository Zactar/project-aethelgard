{
  "name": "Project Aethelgard - Multi-Agent AI Runtime",
  "image": "mcr.microsoft.com/devcontainers/python:1-3.11-bookworm",
  
  "features": {
    "ghcr.io/devcontainers/features/docker-in-docker:2": {
      "version": "latest",
      "enableDockerBuildKit": true
    },
    "ghcr.io/devcontainers/features/common-utils:2": {
      "installZsh": true,
      "configureZshAsDefaultShell": true
    }
  },

  "forwardPorts": [8765, 8766, 8000],

  "portsAttributes": {
    "8765": {
      "label": "Cognitive IPC & State Bridge (WS)",
      "onAutoForward": "notify",
      "protocol": "http"
    },
    "8766": {
      "label": "Streaming 24kHz PCM Audio (WS)",
      "onAutoForward": "silent",
      "protocol": "http"
    },
    "8000": {
      "label": "Chroma Vector Database",
      "onAutoForward": "silent",
      "protocol": "http"
    }
  },

  "customizations": {
    "vscode": {
      "settings": {
        "python.defaultInterpreterPath": "/usr/local/bin/python",
        "python.analysis.typeCheckingMode": "basic",
        "editor.formatOnSave": true,
        "editor.codeActionsOnSave": {
          "source.fixAll.ruff": "explicit",
          "source.organizeImports.ruff": "explicit"
        },
        "terminal.integrated.defaultProfile.linux": "zsh"
      },
      "extensions": [
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "ms-azuretools.vscode-docker",
        "tamasfe.even-better-toml"
      ]
    }
  },

  "postCreateCommand": "pip install --upgrade pip && pip install websockets pydantic langgraph numpy pytest pytest-asyncio chromadb ruff mypy",

  "remoteUser": "vscode"
}